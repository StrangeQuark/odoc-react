{
  "name": "odoc-react",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:mock": "ODOC_E2E_MODE=mock playwright test e2e/smoke.spec.ts --project=chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "test:watch": "vitest",
    "api:generate": "openapi-typescript openapi/odoc-v1.json --output src/generated/odoc-api.ts",
    "api:generate:thin-slice": "openapi-typescript openapi/odoc-thin-slice-v1.json --output src/generated/odoc-thin-slice-api.ts",
    "api:check": "node scripts/check-contract-manifest.mjs && openapi-typescript openapi/odoc-v1.json --output src/generated/odoc-api.ts --check && openapi-typescript openapi/odoc-thin-slice-v1.json --output src/generated/odoc-thin-slice-api.ts --check",
    "api:guard:proof": "node scripts/prove-contract-guard.mjs",
    "ci:negative-controls": "node scripts/verify-ci-negative-controls.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tiptap/core": "3.30.1",
    "@tiptap/extension-file-handler": "3.30.1",
    "@tiptap/extension-highlight": "3.30.1",
    "@tiptap/extension-link": "3.30.1",
    "@tiptap/extension-placeholder": "3.30.1",
    "@tiptap/extension-table": "3.30.1",
    "@tiptap/extension-table-cell": "3.30.1",
    "@tiptap/extension-table-header": "3.30.1",
    "@tiptap/extension-table-row": "3.30.1",
    "@tiptap/extension-task-item": "3.30.1",
    "@tiptap/extension-task-list": "3.30.1",
    "@tiptap/extension-text-align": "3.30.1",
    "@tiptap/extension-underline": "3.30.1",
    "@tiptap/react": "3.30.1",
    "@tiptap/starter-kit": "3.30.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lexical/code": "0.49.0",
    "@lexical/headless": "0.49.0",
    "@lexical/list": "0.49.0",
    "@lexical/rich-text": "0.49.0",
    "@lexical/table": "0.49.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.13.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "lexical": "0.49.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
